# x402-micro-tollgate — copy to .env
#
# Live settlement (3 required):
#   CDP_API_KEY_ID=
#   CDP_API_KEY_SECRET=
#   X402_PAY_TO=0xYourReceivingAddress
#
# Bazaar discovery (recommended for public listing):
#   PUBLIC_BASE_URL=https://your.public.host
# Listing is a no-op on localhost until PUBLIC_BASE_URL is https + one CDP settlement.
#
# Without CDP keys: demo mode (HTTP 402 + MCP PaymentRequired still work).

PORT=8402
# PUBLIC_BASE_URL=https://tollgate.example.com

# Your API. Unset → built-in mock (GET /v1/quote).
# UPSTREAM_URL=https://api.example.com

# X402_PAY_TO=0xYourReceivingAddress
PRICE=$0.001
# NETWORK=eip155:84532
X402_ENVIRONMENT=development
GATED_PREFIX=/v1

# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# CONTACT_EMAIL=2767111713@qq.com

# FeeSplitter operator knobs (Plan A):
# FEE_BPS=10
# FEE_COLLECTOR defaults to fixed operator 0xa922F38041B5ee227c96A547F106F1330447e30E
# FEE_COLLECTOR=0xa922F38041B5ee227c96A547F106F1330447e30E

# Merchant registry (maps merchantId → FeeSplitter payTo + seller). Prefer MERCHANTS_JSON on Render.
# MERCHANTS_JSON={"demo":{"seller":"0xa922F38041B5ee227c96A547F106F1330447e30E","payTo":"0xC20bC6cAc978f8d2AE94Ee9D41F2DF396A5f10fE","label":"demo (operator is also seller)"}}
# MERCHANTS_FILE=merchants.json
# DEFAULT_MERCHANT=demo
# Call gated APIs with ?merchant=id or header x-merchant-id

# x402-micro-tollgate — copy to .env
#
# Live settlement (3 required):
#   CDP_API_KEY_ID=
#   CDP_API_KEY_SECRET=
#   X402_PAY_TO=0xYourReceivingAddress
#
# Bazaar discovery (recommended for public listing):
#   PUBLIC_BASE_URL=https://your.public.host
# Listing is a no-op on localhost until PUBLIC_BASE_URL is https + one CDP settlement.
#
# Without CDP keys: demo mode (HTTP 402 + MCP PaymentRequired still work).

PORT=8402
# PUBLIC_BASE_URL=https://tollgate.example.com

# Your API. Unset → built-in mock (GET /v1/quote).
# UPSTREAM_URL=https://api.example.com

# X402_PAY_TO=0xYourReceivingAddress
PRICE=$0.001
# NETWORK=eip155:84532
X402_ENVIRONMENT=development
GATED_PREFIX=/v1

# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# CONTACT_EMAIL=2767111713@qq.com
# Optional FeeSplitter operator knobs (live settle still pays 100% to X402_PAY_TO until you deploy):
# FEE_BPS=10
# FEE_COLLECTOR=0xYourOperatorWallet

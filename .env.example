# x402-micro-tollgate — copy to .env
#
# Live settlement (3 required):
#   CDP_API_KEY_ID=
#   CDP_API_KEY_SECRET=
#   X402_PAY_TO=0xYourReceivingAddress
#   (or SELLER=0x… for permissionless path — SDK payTo falls back to seller)
#
# Bazaar discovery (recommended for public listing):
#   PUBLIC_BASE_URL=https://your.public.host
# Listing is a no-op on localhost until PUBLIC_BASE_URL is https + one CDP settlement.
#
# Without CDP keys: demo mode (HTTP 402 + MCP PaymentRequired still work).

PORT=8402
# PUBLIC_BASE_URL=https://tollgate.example.com

# Your API. Unset → built-in mock (GET /v1/quote).
# UPSTREAM_URL=https://api.example.com
# After payment, tollgate injects X-Tollgate-Secret / X-Tollgate-Paid (HMAC).
# Upstream must require these headers and reject public direct hits (not mTLS).
# UPSTREAM_SHARED_SECRET=change-me
# X402_UPSTREAM_SECRET=change-me   # alias

# X402_PAY_TO=0xYourReceivingAddress
PRICE=$0.001
# Primary network (default: Base Sepolia in development, Base in production)
# NETWORK=eip155:84532
# NETWORK=base
X402_ENVIRONMENT=development
GATED_PREFIX=/v1

# --- Multi-network × multi-asset accepts (default = primary USDC only; Render-safe) ---
# NETWORKS=base,optimism,arbitrum,polygon
# X402_NETWORKS=eip155:8453,eip155:10,eip155:42161,eip155:137,eip155:56,eip155:1
# ASSETS=USDC,USDT
# X402_ASSETS=usdc,usdt
# Full control (JSON array). Aliases X402_ACCEPTS_JSON also work.
# ACCEPTS_JSON=[{"network":"base","asset":"USDC"},{"network":"base","asset":"USDT"},{"network":"arbitrum","asset":"USDC"}]
# Solana (experimental — requires payTo; not default):
# NETWORKS=base,solana
# SOLANA_PAY_TO=YourBase58SellerPubkey
# PAYWALL_SVM=true
# TRON is planned-only — do not put tron in NETWORKS (rejected). See contracts/deployments/tron.planned.json
# Per-chain FeeSplitterFactory (Base live; others optional stubs):
# FACTORY_ADDRESS=0x20387e081E6fa05cdE0DBb42765D7C62e70e836a
# FACTORY_ADDRESSES={"eip155:8453":"0x20387e081E6fa05cdE0DBb42765D7C62e70e836a"}

# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Browser paywall wallets (Passkey Smart Wallet primary; MetaMask / injected / WalletConnect):
# CDP_CLIENT_API_KEY=
# Optional alias: CDP_CLIENT_KEY=
# WALLETCONNECT_PROJECT_ID=
# When CDP_API_KEY_ID + CDP_API_KEY_SECRET are set, POST /x402/session-token
# mints Coinbase Onramp session tokens for the "Get USDC" button on HTML 402s.
# Multi-accept HTML paywall shows a chain + asset picker before signing.
# Apple Pay / card availability depends on Onramp production + domain allowlist —
# do not expect a guaranteed "10 second Apple Pay" without Portal approval.

# CONTACT_EMAIL=2767111713@qq.com

# FeeSplitter operator knobs (Plan A):
# FEE_BPS=10
# FEE_COLLECTOR defaults to fixed operator 0xa922F38041B5ee227c96A547F106F1330447e30E
# FEE_COLLECTOR=0xa922F38041B5ee227c96A547F106F1330447e30E

# Permissionless seller (0.3.0) — MERCHANTS_JSON not required:
# SELLER=0xYourSellerEoa
# X402_SELLER=0xYourSellerEoa   # alias
# FEE_FREE_BELOW_USDC=10000000  # $10 USDC (6 decimals). amount < this → payTo=seller (0 fee)
# X402_FEE_FREE_BELOW_USDC=10000000  # alias
# FACTORY_ADDRESS=0x…   # operator-set; Base live factory in contracts/deployments/base.json
# SDK: app.use('/v1', await x402Tollgate({ seller: process.env.SELLER }))
# ≥ $10 → CREATE2 FeeSplitter payTo; operator must getOrCreate(seller) before first settle.
# receive → later release() — NOT same-tx atomic split. Check EIP-55 checksums (typo risk).
# Do not hardcode secrets / private keys.

# Merchant registry (optional hosted multi-tenant). Prefer MERCHANTS_JSON on Render.
# MERCHANTS_JSON={"demo":{"seller":"0xa922F38041B5ee227c96A547F106F1330447e30E","payTo":"0xC20bC6cAc978f8d2AE94Ee9D41F2DF396A5f10fE","label":"demo (operator is also seller)"}}
# MERCHANTS_FILE=merchants.json
# DEFAULT_MERCHANT=demo
# Call gated APIs with ?merchant=id or header x-merchant-id
# Agents SHOULD send merchant id; missing → DEFAULT_MERCHANT (demo) when no SELLER.
# REQUIRE_MERCHANT=true

# Payment-proof idempotency (mutex + PaymentDedupeStore; CDP EIP-3009 nonce is source of truth):
# PAYMENT_DEDUPE_TTL_MS=600000
# PAYMENT_DEDUPE_MAX_ENTRIES=10000
# Verify vs settle budgets (Base congestion → prefer pending + retry same proof):
# X402_VERIFY_TIMEOUT_MS=15000
# X402_SETTLE_TIMEOUT_MS=180000

# --- Gas / micropayment floor (OFF by default — demo $0.001 stays cheap on normal Base fees) ---
# Micropayments assume Base low fees. When L2 gas spikes, optional dynamic floor raises
# the minimum accept amount (and may raise feeFreeBelow) so gas cannot eat most of the payment.
# X402_MIN_PRICE_USDC=1000          # static floor in atomic USDC ($0.001); unset = use PRICE only
# X402_FEE_FREE_BELOW_USDC=10000000 # alias for FEE_FREE_BELOW_USDC
# X402_DYNAMIC_MIN_ENABLED=true     # enable Base base-fee oracle + auto bump (default false)
# X402_GAS_COST_MAX_FRACTION=0.5    # bump when estimated gas USD > this fraction of the payment
# X402_GAS_ORACLE_TTL_MS=30000      # baseFee cache TTL (clamped 15–60s) — do not spam RPC
# X402_GAS_RPC_URL=https://mainnet.base.org   # or BASE_RPC_URL; defaults by NETWORK
# X402_GAS_USED_ESTIMATE=100000     # rough L2 gas units for settle estimate
# X402_ETH_USD=4000                 # conservative ETH/USD floor (no live FX required)
# Effective mins are exposed on GET /health → gasFloor.*

# Optional alternate x402 facilitator URL (single-vendor CDP by default).
# Applied to MCP createCdpFacilitatorClient({ baseUrl }). No multi-facilitator routing yet.
# HTTP live createX402Server still uses the CDP default until the SDK exposes an override.
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP_FACILITATOR_URL=…   # alias

# Optional FeeSplitter release keeper (OFF by default — do not enable on Render free tier lightly).
# Gas for release() can exceed 0.1% of sub-cent payments; min balance gate mitigates that.
# Never put keys in the repo. Prefer KEEPER_DRY_RUN=true first.
# KEEPER_ENABLED=true
# KEEPER_DRY_RUN=true
# KEEPER_PRIVATE_KEY=0x...   # only when dry-run is false
# KEEPER_RPC_URL=https://sepolia.base.org
# KEEPER_INTERVAL_MS=3600000
# KEEPER_MIN_USDC=1000000    # $1 USDC (atomic, 6 decimals)

# --- Human-delegated agent credit CLI PoC (scripts/buyer-agent-poc.ts) ---
# SAFETY: hot wallet ≤ $5–$10 USDC only. Never commit BUYER_PRIVATE_KEY.
# BUYER_PRIVATE_KEY=0x...
# TARGET_URL=https://x402-micro-tollgate.onrender.com/v1/quote
# MAX_SINGLE_USDC=0.05
# MAX_TOTAL_USDC=1.00
# ROUNDS=3
# npm run poc:buyer-agent
